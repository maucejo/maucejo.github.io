// UI components for the aucejo theme.
//
// Each helper emits plain HTML elements with `mx-*` classes, styled by themes/aucejo/css/60_aucejo.css. Import them in a page with #import "/_lib/ui.typ": *

#let el(tag, class: none, attrs: (:), body) = {
  let a = attrs
  if class != none { a.insert("class", class) }
  html.elem(tag, attrs: a, body)
}

#let link-out(href, body, class: none) = {
  let a = (href: href)
  if href.starts-with("http") {
    a.insert("target", "_blank")
    a.insert("rel", "noopener")
  }
  el("a", class: class, attrs: a, body)
}

/// A page section with a small uppercase kicker above an h2 title.
#let section(title, kicker: none, id: none, body) = {
  let attrs = if id != none { (id: id) } else { (:) }
  el("section", class: "mx-section", attrs: attrs, {
    el("header", class: "mx-section-head", {
      if kicker != none { el("p", class: "mx-kicker", kicker) }
      el("h2", class: "mx-section-title", title)
    })
    body
  })
}

// Lead paragraph, slightly larger than body text.
#let lead(body) = el("p", class: "mx-lead", body)

// Pill-shaped tags.
#let chips(..items) = el("ul", class: "mx-chips",
  items.pos().map(i => el("li", class: "mx-chip", i)).join())

// Responsive grid of cards. `cols` is the max number of columns.
#let cards(cols: 3, ..items) = el("div", class: "mx-cards",
  attrs: (style: "--mx-cols: " + str(cols)), items.pos().join())

// One card. When `href` is given, the whole card is a link. `stats` is optional content shown in a footer row at the bottom of the card.
#let card(title, href: none, tag: none, icon: none, meta: none, stats: none, body) = {
  let inner = {
    if icon != none or tag != none {
      el("div", class: "mx-card-top", {
        if icon != none { el("span", class: "mx-card-icon", icon) }
        if tag != none { el("span", class: "mx-card-tag", tag) }
      })
    }
    el("h3", class: "mx-card-title", title)
    el("div", class: "mx-card-body", body)
    if meta != none { el("p", class: "mx-card-meta", meta) }
    if stats != none { el("div", class: "mx-card-stats", stats) }
    if href != none { el("span", class: "mx-card-arrow", attrs: ("aria-hidden": "true"), "→") }
  }
  if href != none {
    link-out(href, class: "mx-card is-link", inner)
  } else {
    el("article", class: "mx-card", inner)
  }
}

// Vertical timeline. Items: (when: "2019", what: [...], where: [...])
#let timeline(..items) = el("ol", class: "mx-timeline", items.pos().map(it =>
  el("li", class: "mx-timeline-item", {
    el("span", class: "mx-timeline-when", it.when)
    el("div", class: "mx-timeline-body", {
      el("p", class: "mx-timeline-what", it.what)
      if it.at("where", default: none) != none {
        el("p", class: "mx-timeline-where", it.at("where"))
      }
    })
  })
).join())

// Row of key figures. Items: (value: "84", label: "publications")
#let stats(..items) = el("dl", class: "mx-stats", items.pos().map(it =>
  el("div", class: "mx-stat", {
    el("dt", class: "mx-stat-label", it.label)
    el("dd", class: "mx-stat-value", it.value)
  })
).join())

// Inline image (e.g. a language logo) sized to the text.
#let logo(src, alt) = html.elem("img", attrs: (class: "mx-inline-logo", src: src, alt: alt))

// Call-to-action button.
#let button(href, body, ghost: false) = link-out(href,
  class: if ghost { "mx-btn mx-btn-ghost" } else { "mx-btn mx-btn-primary" }, body)

// ---------------------------------------------------------------------------
// Software (data/software.json, generated by scripts/update_software.py)
// ---------------------------------------------------------------------------

#let software = json("/data/software.json").packages

// Version + GitHub stars of a repository, from its GitHub URL. None when the repository is not in data/software.json (re-run the update script).
#let repo-stats(href) = {
  let repo = href.replace(regex("^https://github\.com/"), "").trim("/")
  let info = software.at(repo, default: none)
  if info == none { return none }
  if info.version != none {
    el("span", class: "mx-badge mx-badge-version",
      attrs: (title: "Latest version (" + info.version_source + ")"), "v" + info.version)
  }
  el("span", class: "mx-badge mx-badge-stars", attrs: (title: str(info.stars) + " GitHub stars"), {
    el("span", class: "mx-badge-icon", attrs: ("aria-hidden": "true"), "")
    str(info.stars)
  })
}

// A card for a package hosted on GitHub: same as `card`, plus its version and star count.
#let software-card(title, href: none, ..args) = card(title, href: href,
  stats: if href != none { repo-stats(href) }, ..args)

// ---------------------------------------------------------------------------
// Publications (data/publications.json, generated from HAL)
// ---------------------------------------------------------------------------

#let publications = json("/data/publications.json")

#let category-labels = (
  article: "Journal article",
  conference: "Conference",
  chapter: "Book chapter",
  thesis: "Thesis",
)

#let category-plurals = (
  article: "Journal articles",
  conference: "Conferences",
  chapter: "Book chapters",
  thesis: "Theses",
)

#let _is-me(name) = name in ("Mathieu Aucejo", "M. Aucejo", "Aucejo Mathieu")

#let _authors(names) = names.enumerate().map(((i, n)) => {
  let sep = if i == 0 { "" } else if i == names.len() - 1 { " and " } else { ", " }
  sep
  if _is-me(n) { el("strong", class: "mx-me", n) } else { n }
}).join()

// One publication entry.
#let pub(p) = el("li", class: "mx-pub", attrs: (
  "data-category": p.category,
  "data-year": str(p.year),
  "data-search": lower(p.title + " " + p.authors.join(" ") + " " + p.venue),
), {
  el("div", class: "mx-pub-side", {
    el("span", class: "mx-pub-year", str(p.year))
  })
  el("div", class: "mx-pub-main", {
    el("span", class: "mx-pub-type is-" + p.category, category-labels.at(p.category))
    el("p", class: "mx-pub-title", {
      let href = if p.doi != "" { "https://doi.org/" + p.doi } else { p.hal }
      link-out(href, p.title)
    })
    el("p", class: "mx-pub-authors", _authors(p.authors))
    if p.venue != "" { el("p", class: "mx-pub-venue", p.venue) }
    el("p", class: "mx-pub-links", {
      if p.doi != "" { link-out("https://doi.org/" + p.doi, class: "mx-pub-link", "DOI") }
      if p.hal != "" { link-out(p.hal, class: "mx-pub-link", "HAL") }
      if p.pdf != "" { link-out(p.pdf, class: "mx-pub-link is-pdf", "PDF") }
      let n = p.at("citations", default: none)
      if n != none {
        let label = str(n) + if n == 1 { " citation" } else { " citations" } + " (OpenAlex)"
        let oa = p.at("openalex", default: "")
        let href = if oa != "" {
          "https://openalex.org/works?filter=cites:" + oa.split("/").last()
        } else { "https://doi.org/" + p.doi }
        el("a", class: "mx-pub-cites" + if n == 0 { " is-zero" } else { "" }, attrs: (
          href: href, target: "_blank", rel: "noopener", title: label, "aria-label": label,
        ), {
          el("span", class: "mx-pub-cites-icon", attrs: ("aria-hidden": "true"), "")
          el("span", class: "mx-pub-cites-count", str(n))
        })
      }
    })
  })
})

// List of publications, optionally filtered by category and truncated.
#let pub-list(category: none, limit: none) = {
  let items = publications.filter(p => category == none or p.category == category)
  if limit != none { items = items.slice(0, calc.min(limit, items.len())) }
  el("ol", class: "mx-pubs", items.map(pub).join())
}

// Search box + category filter, wired up by themes/aucejo/js/publications.js.
#let pub-filters() = {
  let counts = (:)
  for p in publications {
    counts.insert(p.category, counts.at(p.category, default: 0) + 1)
  }
  el("div", class: "mx-pub-filters", attrs: ("data-mx-pub-filters": ""), {
    html.elem("input", attrs: (
      type: "search",
      class: "mx-pub-search",
      placeholder: "Search titles, co-authors, venues…",
      "aria-label": "Search publications",
    ))
    el("div", class: "mx-pub-tabs", attrs: (role: "toolbar", "aria-label": "Filter by type"), {
      html.elem("button", attrs: (type: "button", class: "mx-tab is-active", "data-filter": "all"),
        "All " + html.elem("span", attrs: (class: "mx-tab-count"), str(publications.len())))
      for (key, label) in category-plurals.pairs() {
        if key in counts {
          html.elem("button", attrs: (type: "button", class: "mx-tab", "data-filter": key),
            label + " " + html.elem("span", attrs: (class: "mx-tab-count"), str(counts.at(key))))
        }
      }
    })
    el("p", class: "mx-pub-empty", attrs: (hidden: "hidden"), "No publication matches your search.")
  })
}


// ---------------------------------------------------------------------------
// Blog
//
// A post is any page whose metadata has `kind: "post"`. Calepin indexes every page, so the blog listing, the home page and the prev/next links find posts on their own: create blog/<slug>/index.typ and it appears everywhere.
// Each post is a folder holding its source and its files (images, data…), referenced with paths relative to the folder: #image("figure.png").
//
// Post metadata (see blog/MakieApp/index.typ):
//   title, description, date ("YYYY-MM-DD"),
//   type (one per post, e.g. "Tutorial"; shown on the card, filters the blog),
//   tags (array; shown in the post, link to the blog filtered on that tag),
//   author (optional, defaults to the site owner),
//   cover + cover-alt (optional, path relative to the post folder,
//     or from the site root if it starts with "/"),
//   draft: true (optional, hides the post from listings and the feed),
//   toc: true or (depth: 4) (optional, table of contents beside the post)
// ---------------------------------------------------------------------------

// Calepin runtime (page index, URL helper). It is staged in the `asset-dir` set in calepin.toml (`_calepin`) at build time.
#import "/_calepin/calepin.typ" as calepin

#let default-author = "Mathieu Aucejo"

#let months = ("January", "February", "March", "April", "May", "June", "July",
  "August", "September", "October", "November", "December")

// "2026-11-12" -> "12 November 2026"
#let format-date(d) = {
  let parts = d.split("-").map(int)
  str(parts.at(2)) + " " + months.at(parts.at(1) - 1) + " " + str(parts.at(0))
}

// "Code & tips" -> "code-&-tips": the value used in URLs and data attributes.
#let _slug(s) = lower(s).replace(" ", "-")

// Completes a post's metadata for Calepin: marks it as a post and exposes the description as `summary`, which the Atom feed uses. A draft only keeps its title and description: without a date, Calepin leaves it out of the feed, and without `kind: "post"` it is left out of every listing. `toc: true` shows Calepin's table of contents beside the post; it is off by default (calepin.toml, [toc]). The page title is the <h1>, so `==` headings are level 3: `toc: true` lists them, `toc: (depth: 4)` adds `===` ones.
#let post-meta(meta) = {
  let toc = meta.at("toc", default: false)
  let toc = if type(toc) == dictionary { (enabled: true) + toc } else { (enabled: toc == true, depth: 3) }
  if meta.at("draft", default: false) == true {
    (title: meta.title, description: meta.description, draft: true, toc: toc)
  } else {
    meta + (kind: "post", summary: meta.description, toc: toc)
  }
}

// Published posts (no drafts), newest first. Each entry is a Calepin page:
// (href: relative link, meta: the post metadata, ...).
#let posts() = {
  calepin.pages()
    .filter(p => type(p.at("meta", default: none)) == dictionary)
    .filter(p => p.meta.at("kind", default: none) == "post")
    .filter(p => p.meta.at("draft", default: false) != true)
    .sorted(key: p => p.meta.at("date", default: ""))
    .rev()
}

#let _blog-link(key, value) = calepin.url("/blog.html") + "#" + key + "=" + _slug(value)

// Site-root directory of a page, from its source path or href: "blog/my-post/index.typ" -> "/blog/my-post/".
#let _page-dir(path) = {
  let parts = path.split("/")
  "/" + parts.slice(0, parts.len() - 1).map(x => x + "/").join(default: "")
}

// A post's cover as a site-root path. `cover` is relative to the post's folder ("cover.jpg" -> "/blog/<slug>/cover.jpg"), unless it starts with "/" (path from the site root) or is a full URL.
#let _cover-path(cover, page-path) = {
  if cover.starts-with("/") or cover.contains("://") { cover }
  else { _page-dir(page-path) + cover }
}

// Cover image. The path is made relative to the current page, so it works whatever the server root (or over file://). Calepin then embeds the image in the page: keep covers light (≈1200×630, compressed JPG/WebP or SVG). `page-path` is the post's source path or href, used to resolve a cover given relative to the post's folder.
#let _cover(meta, class, page-path, lazy: false) = {
  let src = calepin.url(_cover-path(meta.cover, page-path))
  let attrs = (class: class, src: src, alt: meta.at("cover-alt", default: ""))
  if lazy { attrs.insert("loading", "lazy") }
  html.elem("img", attrs: attrs)
}

/// Back link, type + byline, cover and tags, at the top of a post page.
#let post-header(meta) = {
  let author = meta.at("author", default: default-author)
  let tags = meta.at("tags", default: ())
  el("div", class: "mx-post-head", {
    el("a", class: "mx-post-back", attrs: (href: calepin.url("/blog.html")), "← All posts")
    el("div", class: "mx-post-byline", {
      if "type" in meta {
        el("a", class: "mx-post-type", attrs: (href: _blog-link("type", meta.type)), meta.type)
      }
      el("span", class: "mx-post-author", author)
      el("span", class: "mx-post-sep", attrs: ("aria-hidden": "true"), "·")
      html.elem("time", attrs: (datetime: meta.date), format-date(meta.date))
      // Filled in by aucejo.js from the length of the post.
      el("span", class: "mx-post-sep mx-post-reading-sep", attrs: ("aria-hidden": "true", hidden: "hidden"), "·")
      el("span", class: "mx-post-reading", attrs: (hidden: "hidden"), "")
    })
    if "cover" in meta {
      _cover(meta, "mx-post-cover", sys.inputs.at("calepin-current-href", default: ""))
    }
    if tags.len() > 0 {
      el("ul", class: "mx-post-tags", attrs: ("aria-label": "Tags"), tags.map(t =>
        el("li", el("a", attrs: (href: _blog-link("tag", t)), {
          el("span", class: "mx-post-tag-hash", attrs: ("aria-hidden": "true"), "#")
          t
        }))).join())
    }
  })
}

/// Previous / next post links, at the bottom of a post page.
#let post-footer(meta) = {
  let all = posts()
  let i = all.position(p => p.meta.title == meta.title and p.meta.date == meta.date)
  let newer = if i != none and i > 0 { all.at(i - 1) } else { none }
  let older = if i != none and i + 1 < all.len() { all.at(i + 1) } else { none }
  if older == none and newer == none { return }
  html.elem("nav", attrs: (class: "mx-post-nav", "aria-label": "More posts"), {
    if older != none {
      el("a", class: "mx-post-nav-link is-prev", attrs: (href: older.href), {
        el("span", class: "mx-post-nav-label", "← Previous post")
        el("span", class: "mx-post-nav-title", older.meta.title)
      })
    } else { el("span", "") }
    if newer != none {
      el("a", class: "mx-post-nav-link is-next", attrs: (href: newer.href), {
        el("span", class: "mx-post-nav-label", "Next post →")
        el("span", class: "mx-post-nav-title", newer.meta.title)
      })
    }
  })
}

/// One post card (`page` is an entry of `posts()`). Shows the post type;
/// the tags are not displayed but stay searchable and filterable.
#let post-card(page) = {
  let meta = page.meta
  let tags = meta.at("tags", default: ())
  let author = meta.at("author", default: default-author)
  let kind = meta.at("type", default: none)
  let haystack = lower(meta.title + " " + meta.description + " " + author + " "
    + (if kind != none { kind } else { "" }) + " "
    + tags.join(" ") + " " + meta.date + " " + format-date(meta.date))
  el("a", class: "mx-card is-link mx-post", attrs: (
    href: page.href,
    "data-search": haystack,
    "data-type": if kind != none { _slug(kind) } else { "" },
    "data-tags": tags.map(_slug).join("|"),
  ), {
    if kind != none {
      el("div", class: "mx-card-top", el("span", class: "mx-card-tag", kind))
    }
    if "cover" in meta { _cover(meta, "mx-card-cover", page.path, lazy: true) }
    el("h3", class: "mx-card-title", meta.title)
    el("div", class: "mx-card-body", meta.description)
    el("p", class: "mx-card-meta", {
      author + " · "
      html.elem("time", attrs: (datetime: meta.date), format-date(meta.date))
    })
    el("span", class: "mx-card-arrow", attrs: ("aria-hidden": "true"), "→")
  })
}

/// The `n` most recent posts as cards (for the home page). Empty if none.
#let latest-posts(n: 2) = {
  let items = posts()
  if items.len() > 0 {
    el("div", class: "mx-cards mx-posts", attrs: (style: "--mx-cols: 2"),
      items.slice(0, calc.min(n, items.len())).map(post-card).join())
  }
}

/// Full blog listing: search box, type filter and all posts.
/// The filters follow the URL hash: blog.html#type=tutorial selects a type,
/// blog.html#tag=typst (the tag links in posts) filters on a tag.
#let blog() = {
  let items = posts()
  let counts = (:)
  for p in items {
    let kind = p.meta.at("type", default: none)
    if kind != none { counts.insert(kind, counts.at(kind, default: 0) + 1) }
  }
  el("div", class: "mx-pub-filters", attrs: ("data-mx-post-filters": ""), {
    html.elem("input", attrs: (
      type: "search",
      class: "mx-pub-search",
      placeholder: "Search titles, keywords, tags, author…",
      "aria-label": "Search posts",
    ))
    el("div", class: "mx-pub-tabs", attrs: (role: "toolbar", "aria-label": "Filter by type"), {
      html.elem("button", attrs: (type: "button", class: "mx-tab is-active", "data-filter": "all", "aria-pressed": "true"),
        "All " + html.elem("span", attrs: (class: "mx-tab-count"), str(items.len())))
      for (kind, n) in counts.pairs().sorted(key: kv => lower(kv.at(0))) {
        html.elem("button", attrs: (type: "button", class: "mx-tab", "data-filter": _slug(kind), "aria-pressed": "false"),
          kind + " " + html.elem("span", attrs: (class: "mx-tab-count"), str(n)))
      }
    })
    // Shown by aucejo.js when the page is opened from a tag link.
    el("p", class: "mx-post-active-tag", attrs: (hidden: "hidden"), {
      "Tag: "
      el("strong", "")
      html.elem("button", attrs: (type: "button", class: "mx-post-clear-tag", "aria-label": "Remove tag filter"), "×")
    })
    el("p", class: "mx-pub-empty", attrs: (hidden: "hidden"), "No post matches your search.")
  })
  if items.len() == 0 {
    el("p", class: "mx-note", "No posts yet.")
  } else {
    el("div", class: "mx-cards mx-posts", attrs: (style: "--mx-cols: 2"),
      items.map(post-card).join())
  }
  el("p", class: "mx-note", {
    "Follow new posts with the "
    el("a", attrs: (href: calepin.url("/atom.xml")), "Atom feed")
    "."
  })
}

// ---------------------------------------------------------------------------
// Equations in HTML pages. Use in a page: #show: math-html
//  - block equations are rendered by Typst as SVG (exact layout), wrapped in
//    <div class="mx-equation"> so the theme can centre them;
//  - inline equations stay MathML. Typst emits combining marks (U+0307,
//    U+0308…) for dot(), dot.double()…, which browsers draw misplaced, so they
//    are swapped for the spacing variants, which MathML positions correctly.
// ---------------------------------------------------------------------------
#let _spacing-accents = (
  "\u{300}": $\u{60}$,   // grave
  "\u{301}": $\u{B4}$,   // acute
  "\u{303}": $\u{2DC}$,  // tilde
  "\u{304}": $\u{AF}$,   // macron
  "\u{306}": $\u{2D8}$,  // breve
  "\u{307}": $\u{2D9}$,  // dot
  "\u{308}": $\u{A8}$,   // dot.double
  "\u{30A}": $\u{2DA}$,  // circle
  "\u{30C}": $\u{2C7}$,  // caron
)
#let math-font = "STIX Two Math"
#let math-html(body) = {
  // Font of the SVG equations (Typst draws the glyphs, so it only has to be
  // installed where `calepin compile` runs). Inline MathML uses the web font
  // declared in the theme CSS.
  show math.equation: set text(font: math-font)
  show math.equation.where(block: true): it => context {
    if target() == "html" {
      el("div", class: "mx-equation", html.frame(it))
    } else { it }
  }
  show math.accent: it => context {
    if target() == "html" and it.accent in _spacing-accents {
      html.elem("mover", attrs: (accent: "true"),
        { it.base; _spacing-accents.at(it.accent) })
    } else { it }
  }
  body
}
